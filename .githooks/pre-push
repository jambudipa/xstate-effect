#!/bin/sh
# Pre-push gate: the whole suite with the coverage thresholds of packages/core/vitest.config.ts.
# A fresh clone turns it on with `git config core.hooksPath .githooks`; `pnpm install` in
# packages/core runs that command through its prepare script.
set -e
cd "$(git rev-parse --show-toplevel)/packages/core"
exec pnpm test:coverage
